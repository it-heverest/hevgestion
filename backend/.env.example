# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password

# For Gmail, you need to:
# 1. Enable 2-Factor Authentication
# 2. Generate an App Password at: https://myaccount.google.com/signinoptions/sign-in-methods
# 3. Use the 16-character app password here (not your regular Gmail password)