# DGI TAS Server
DGI_API_URL=http://tasserver.dgi.cm/api/v1
DGI_TIMEOUT=60000

# Encryption (must be exactly 32 bytes: 32-char ASCII or 64-char hex via `openssl rand -hex 32`)
ENCRYPTION_KEY=your-64-char-hex-key-here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password

# For Gmail, you need to:
# 1. Enable 2-Factor Authentication
# 2. Generate an App Password at: https://myaccount.google.com/signinoptions/sign-in-methods
# 3. Use the 16-character app password here (not your regular Gmail password)